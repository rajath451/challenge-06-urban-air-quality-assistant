# ==========================================
# VayuCoach Urban Air Quality Intelligence
# Environment Configuration
# ==========================================

# 1. Google Gemini API Key (For grounded conversational advice & reasoning)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Server & Security Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "*"]
JWT_SECRET_KEY=vayucoach-production-secret-key-32bytes-long-super-safe!

# 3. Centralized SMTP Email Service (Brevo / Sendinblue / Amazon SES / Mailgun)
# Example Brevo SMTP Relay:
# Host: smtp-relay.brevo.com
# Port: 587 (TLS) or 465 (SSL)
SMTP_PROVIDER=brevo
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_smtp_login@smtp-brevo.com
SMTP_PASSWORD=your_brevo_smtp_master_key
SMTP_FROM_EMAIL=notifications@vayucoach.in
SMTP_FROM_NAME=VayuCoach Environmental Intelligence
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT=15

# Mock fallback: When true, logs rendered email payloads to terminal & delivery store
# if SMTP credentials are placeholder or network is unavailable
SMTP_MOCK_FALLBACK=true

# 4. Frontend Web App Base URL (Used for generating email verification & password reset links)
FRONTEND_URL=http://localhost:5173

# 5. Rate Limiting & Delivery Policies
MAX_EMAILS_PER_USER_PER_HOUR=5
AQI_ALERT_DEDUPLICATION_HOURS=6
TOKEN_VERIFICATION_EXPIRY_HOURS=24
TOKEN_PASSWORD_RESET_EXPIRY_HOURS=1

# 6. Database & Supabase Authentication
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key
